# Bu dosyayı .env olarak kopyalayın. .env ASLA commit edilmez.

# Google Street View API (ilk 10.000 istek ücretsiz kota)
GOOGLE_STREET_VIEW_API_KEY=

# Hugging Face (model/dataset erişimi)
HUGGINGFACE_TOKEN=

# Canlı servis URL'leri (Render + Vercel)
NEXT_PUBLIC_API_URL=https://nobetci-backend.onrender.com
AI_SERVICE_URL=https://nobetci-ai-service.onrender.com

# Resmi açık veri lokasyon kaynağı
# Varsayılan: İBB Açık Veri / Muhtarlık Adres Bilgileri GeoJSON
LOCATION_OPEN_DATA_URL=

# Cadde/sokak listesi (OpenStreetMap / Overpass)
STREET_LOOKUP_RADIUS_M=500
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# LLM (dilekçe üretimi — opsiyonel, yoksa şablon fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Demo modu — Render free tier için true önerilir
DEMO_MODE=true

# Admin panel (backend + web proxy aynı anahtar)
ADMIN_API_KEY=

# Hackathon sonrası uzman modeller (Standard tier)
ENABLE_SPECIALIST_MODELS=false
