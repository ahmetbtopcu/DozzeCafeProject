# Bu dosyayı .env olarak kopyalayın. .env ASLA commit edilmez.

# Google Street View API (ilk 10.000 istek ücretsiz kota)
GOOGLE_STREET_VIEW_API_KEY=

# Hugging Face (model/dataset erişimi)
HUGGINGFACE_TOKEN=

# Canlı servis URL'leri (Render + Vercel)
NEXT_PUBLIC_API_URL=https://nobetci-backend.onrender.com
EXPO_PUBLIC_API_URL=https://nobetci-backend.onrender.com
AI_SERVICE_URL=https://nobetci-ai-service.onrender.com

# LLM (dilekçe üretimi — opsiyonel, yoksa şablon fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Demo modu — gerçek model inference için false. true ise cache'li örnekler döner.
DEMO_MODE=false

# Yol hasarı (RDD2022) uzman modeli. Doğruluk için true (Standard tier RAM gerekir).
ENABLE_SPECIALIST_MODELS=true

# Çöp: fine-tune edilmiş model konduktan sonra true yapın (scripts/finetune/).
ENABLE_GARBAGE_SPECIALIST=false

# CLIP sahne doğrulama katmanı (önce sahneyi tanır, sonra ilgili model çalışır).
ENABLE_CLIP_ROUTER=true
CLIP_MODEL_NAME=ViT-B/32

# Tespit zaman aşımı (sn) — CPU'da soğuk başlangıç için 30 önerilir.
DETECT_TIMEOUT_SEC=30
