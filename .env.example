# Bu dosyayı .env olarak kopyalayın ve doldurun. .env ASLA commit edilmez.

# Google Street View API (ilk 10.000 istek ücretsiz kota)
GOOGLE_STREET_VIEW_API_KEY=

# Hugging Face (model/dataset erişimi)
HUGGINGFACE_TOKEN=

# Servis URL'leri
NEXT_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
